# Скопируйте этот файл в .env и подставьте свои значения:
# cp .env.example .env

# PostgreSQL (контейнер db) и подключение Django к базе (контейнер backend)
POSTGRES_DB=kittygram
POSTGRES_USER=kittygram_user
POSTGRES_PASSWORD=kittygram_password
DB_HOST=db
DB_PORT=5432

# Django
SECRET_KEY=замените_на_длинный_случайный_ключ
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,ваш_домен_kittygram,IP_сервера
CSRF_TRUSTED_ORIGINS=https://ваш_домен_kittygram

# Логин на Docker Hub — нужен docker-compose.production.yml на сервере
DOCKERHUB_USERNAME=ваш_логин_на_dockerhub
